{
  "permissions": {
    "allow": ["Read(./docs/**)", "Bash(git status:*)", "Bash(git diff:*)"],
    "deny": ["Read(./.env)", "Bash(curl:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "npx prettier@3.4.2 --write \"$CLAUDE_FILE_PATHS\"" }]
      }
    ]
  }
}
